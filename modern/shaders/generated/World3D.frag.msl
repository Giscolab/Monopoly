#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MaterialUniforms
{
    float4 materialDiffuse;
    float4 sceneAmbient;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

fragment main0_out main0(constant type_MaterialUniforms& MaterialUniforms [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(MaterialUniforms.materialDiffuse.xyz * MaterialUniforms.sceneAmbient.xyz, MaterialUniforms.materialDiffuse.w);
    return out;
}

