#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_SceneUniforms
{
    float4x4 worldViewProjection;
    float4x4 world;
    float4 materialDiffuse;
    float4 sceneAmbient;
    float4 boardReflectionColorEnabled;
    float4 boardReflectionDirection;
    float4 sunColorEnabled;
    float4 sunDirection;
    float4 spotlightColorEnabled;
    float4 spotlightPositionRange;
    float4 spotlightDirectionFalloff;
    float4 spotlightAttenuationTheta;
    float4 spotlightPhi;
};

struct main0_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
};

static inline float saturate1(float value)
{
    return clamp(value, 0.0f, 1.0f);
}

static inline float3 directionalContribution(
    float3 normal, float4 colorEnabled, float3 direction)
{
    if (colorEnabled.w <= 0.5f)
        return float3(0.0f);
    const float diffuse = saturate1(dot(normal, -normalize(direction)));
    return colorEnabled.xyz * diffuse;
}

static inline float3 spotlightContribution(
    float3 normal, float3 worldPosition, constant type_SceneUniforms& uniforms)
{
    if (uniforms.spotlightColorEnabled.w <= 0.5f)
        return float3(0.0f);

    const float3 toLight = uniforms.spotlightPositionRange.xyz - worldPosition;
    const float distanceToLight = length(toLight);
    if (distanceToLight <= 0.000001f || distanceToLight > uniforms.spotlightPositionRange.w)
        return float3(0.0f);

    const float3 lightDirection = toLight / distanceToLight;
    const float diffuse = saturate1(dot(normal, lightDirection));
    if (diffuse <= 0.0f)
        return float3(0.0f);

    const float rho = dot(normalize(uniforms.spotlightDirectionFalloff.xyz), -lightDirection);
    const float cosTheta = cos(uniforms.spotlightAttenuationTheta.w * 0.5f);
    const float cosPhi = cos(uniforms.spotlightPhi.x * 0.5f);
    float cone = 0.0f;
    if (rho >= cosTheta)
        cone = 1.0f;
    else if (rho > cosPhi)
    {
        const float coneRatio = saturate1(
            (rho - cosPhi) / max(cosTheta - cosPhi, 0.000001f));
        cone = pow(coneRatio, max(uniforms.spotlightDirectionFalloff.w, 0.0f));
    }

    const float3 attenuation = uniforms.spotlightAttenuationTheta.xyz;
    const float denominator = attenuation.x +
        attenuation.y * distanceToLight +
        attenuation.z * distanceToLight * distanceToLight;
    const float distanceAttenuation = 1.0f / max(denominator, 0.000001f);
    return uniforms.spotlightColorEnabled.xyz * diffuse * cone * distanceAttenuation;
}

vertex main0_out main0(main0_in in [[stage_in]], constant type_SceneUniforms& SceneUniforms [[buffer(0)]])
{
    main0_out out = {};
    const float4 localPosition = float4(in.in_var_TEXCOORD0, 1.0);
    out.gl_Position = SceneUniforms.worldViewProjection * localPosition;
    const float3 worldPosition = (SceneUniforms.world * localPosition).xyz;
    const float3 normal = normalize((SceneUniforms.world * float4(in.in_var_TEXCOORD1, 0.0)).xyz);
    float3 lighting = SceneUniforms.sceneAmbient.xyz;
    lighting += directionalContribution(normal,
        SceneUniforms.boardReflectionColorEnabled,
        SceneUniforms.boardReflectionDirection.xyz);
    lighting += directionalContribution(normal,
        SceneUniforms.sunColorEnabled, SceneUniforms.sunDirection.xyz);
    lighting += spotlightContribution(normal, worldPosition, SceneUniforms);
    out.out_var_TEXCOORD0 = clamp(SceneUniforms.materialDiffuse.xyz * lighting, 0.0f, 1.0f);
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    return out;
}
