# Repository-wide text policy: Windows checkout uses CRLF.
* text=auto eol=crlf

# POSIX entry-point scripts must remain executable on Unix-like hosts.
*.sh text eol=lf
*.bash text eol=lf

# CMake files must never fall through text=auto binary heuristics.
CMakeLists.txt text eol=crlf
*.cmake text eol=crlf
